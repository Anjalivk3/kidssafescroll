generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  PENDING
  ANALYZED
  ERROR
}

enum RiskLevel {
  SAFE
  LOW
  MEDIUM
  HIGH
}

enum Recommendation {
  ALLOW
  RESTRICT
  REVIEW
}

enum ParentDecision {
  ALLOWED
  RESTRICTED
  REVIEW
}

enum SafetyCategory {
  VIOLENCE
  PROFANITY
  ADULT_CONTENT
  DANGEROUS_BEHAVIOR
  DRUGS
  HATE_CONTENT
  DISTURBING_CONTENT
  SELF_HARM
  NONE
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  children           Child[]
  contentSubmissions ContentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Child {
  id     Int    @id @default(autoincrement())
  name   String
  age    Int
  userId Int

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  safetyPolicy SafetyPolicy?
  submissions  ContentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SafetyPolicy {
  id                  Int @id @default(autoincrement())
  childId             Int @unique

  violence            Boolean @default(true)
  profanity           Boolean @default(true)
  adultContent        Boolean @default(true)
  dangerousBehavior   Boolean @default(true)
  drugs               Boolean @default(true)
  hateContent         Boolean @default(true)
  disturbingContent   Boolean @default(true)
  selfHarm            Boolean @default(true)

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentSubmission {
  id          Int              @id @default(autoincrement())
  userId      Int
  childId     Int
  url         String
  title       String?
  description String?
  transcript  String?
  imageUrl    String?
  status      SubmissionStatus @default(PENDING)

  parentDecision ParentDecision?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  analysis SafetyAnalysis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([childId])
  @@index([userId, createdAt])
}

model SafetyAnalysis {
  id           Int            @id @default(autoincrement())
  submissionId Int            @unique

  riskLevel     RiskLevel
  score         Float
  explanation   String
  recommendation Recommendation

  detectedCategories SafetyCategory[]

  submission ContentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}